APP_DEBUG=false
LOG_LEVEL=error
APP_ENV=production
# Must point to RoadRunner's internal HTTP port (8080), not just localhost: the indexer:* commands
# call file_get_contents(APP_URL . "/v4/..."), which fails with "Connection refused" otherwise.
APP_URL=http://localhost:8080
CACHING=true
CACHE_DRIVER=redis
REDIS_HOST=redis
REDIS_PASSWORD__FILE=/run/secrets/redis_password
DB_CONNECTION=mongodb
DB_HOST=mongodb
DB_DATABASE=jikan
DB_USERNAME__FILE=/run/secrets/db_username
DB_ADMIN__FILE=/run/secrets/db_username
DB_PASSWORD__FILE=/run/secrets/db_password
# Search engine: Typesense via Laravel Scout.
# SCOUT_DRIVER must stay "typesense" (never "null"/"" -> those enable Scout with an invalid driver)
# and TYPESENSE_API_KEY is mandatory: docker-entrypoint.php exits(1) without it.
# SCOUT_QUEUE=false indexes synchronously on every model save() (no queue dependency).
# If Typesense dies, save() fails -> API returns 500: rollback with tag rest-movil-before-typesense.
SCOUT_DRIVER=typesense
SCOUT_QUEUE=false
TYPESENSE_HOST=typesense
TYPESENSE_PORT=8108
TYPESENSE_API_KEY__FILE=/run/secrets/typesense_api_key
# RoadRunner: cap per-worker PHP memory and workers for low-resource boards (Raspberry Pi)
RR_MAX_WORKER_MEMORY=64
RR_NUM_WORKERS=2
CORS_MIDDLEWARE=true
MICROCACHING=true
MICROCACHING_EXPIRE=60